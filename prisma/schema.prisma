generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum InviteStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PUBLISHED
  EXPIRED
  CANCELLED
}

enum GuestStatus {
  COMING
  NOT_COMING
  MAYBE
}

enum PaymentProvider {
  MANUAL_KASPI
  APIPAY
  CLOUDPAYMENTS
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  phone        String?
  passwordHash String?
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invites         Invite[]
  payments        Payment[]
  auditLogs       AuditLog[]
  aiConversations AiConversation[]

  @@index([email])
}

model Invite {
  id          String       @id @default(uuid())
  slug        String       @unique
  title       String
  description String?
  status      InviteStatus @default(DRAFT)
  data        Json         @default("{}")
  expiresAt   DateTime?
  publishedAt DateTime?
  viewCount   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Set when this invite originated from an anonymous pre-account draft
  // (see /api/invites/claim). Unique so claiming the same draft twice
  // (double-submit, redirect retries) idempotently returns the same invite
  // instead of creating a duplicate.
  sourceDraftToken String? @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  guests          Guest[]
  payments        Payment[]
  media           Media[]
  aiConversations AiConversation[]

  @@index([userId])
  @@index([slug])
  @@index([status])
}

model Guest {
  id          String      @id @default(uuid())
  name        String
  phone       String?
  email       String?
  status      GuestStatus @default(MAYBE)
  peopleCount Int         @default(1)
  note        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  inviteId String
  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@index([inviteId])
  @@index([status])
}

model Payment {
  id            String          @id @default(uuid())
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("KZT")
  provider      PaymentProvider
  status        PaymentStatus   @default(PENDING)
  externalId    String?
  rawPayload    Json?
  screenshotUrl String?
  notes         String?
  approvedAt    DateTime?
  approvedBy    String?
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  inviteId String
  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([inviteId])
  @@index([status])
  @@index([externalId])
}

model Media {
  id        String    @id @default(uuid())
  type      MediaType
  url       String
  key       String
  mimeType  String
  size      Int
  createdAt DateTime  @default(now())

  inviteId String
  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@index([inviteId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
}

model SiteSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @default(now()) @updatedAt

  @@index([key])
}

// Keep for backward compat
model ProductSettings {
  id               String   @id @default(uuid())
  productKey       String   @unique
  price            Int
  currency         String   @default("KZT")
  activeDays       Int
  kaspiPaymentLink String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productKey])
}

model AiConversation {
  id        String      @id @default(uuid())
  inviteId  String
  invite    Invite      @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([inviteId, userId])
  @@index([userId])
  @@index([inviteId])
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String         @db.Text
  type           String?
  inputTokens    Int            @default(0)
  outputTokens   Int            @default(0)
  createdAt      DateTime       @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model InviteTemplate {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  nameKk        String?
  nameRu        String?
  category      String
  language      String   @default("both")
  style         String   @default("elegant")
  description   String?
  descriptionRu String?
  previewImage  String?
  demoImage     String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  isPremium     Boolean  @default(false)
  bg            String   @default("#FAF8F3")
  gradient      String   @default("from-stone-50 to-amber-50")
  accent        String   @default("#C4963E")
  textDark      String   @default("#1C1917")
  textMuted     String   @default("#78716C")
  dark          Boolean  @default(false)
  emoji         String   @default("✨")
  demoName1     String   @default("Атыңыз")
  demoName2     String?
  tags          String[] @default([])
  tagsKk        String[] @default([])
  tagsRu        String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@index([category])
}
