generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

// Invite lifecycle (see the auth/lifecycle audit report for the full
// state-machine writeup). Only DRAFT <-> PENDING_PAYMENT <-> PUBLISHED are
// actively used today:
//   DRAFT            being edited / unpaid. Set on creation (both
//                    createInviteFromTemplate and claimAnonymousInvite
//                    always start here) and never re-entered afterward.
//   PENDING_PAYMENT  a Payment row exists and is PENDING (see
//                    /api/payments/create). Reversible: PAYABLE_STATUSES
//                    there includes DRAFT/PENDING_PAYMENT/EXPIRED so a
//                    stalled payment can be retried.
//   PUBLISHED        payment confirmed (webhook or manual-approve) — the
//                    ONLY two places that ever set this status. This is
//                    what gates public visibility in /i/[slug].
//   EXPIRED          set by the expire-invites cron once a PUBLISHED
//                    invite's expiresAt has passed. Still PAYABLE (renewal
//                    re-activates it via the same PENDING_PAYMENT path).
//   PAID             reserved / not currently assigned to Invite.status
//                    anywhere in the codebase (Payment.status does use
//                    "PAID" — a separate model). Kept in the enum for
//                    forward compatibility with a possible future
//                    paid-but-not-yet-published step; do not rely on it.
//   CANCELLED        reserved / not currently assigned anywhere. No admin
//                    or user-facing action sets this today.
enum InviteStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PUBLISHED
  EXPIRED
  CANCELLED
}

enum GuestStatus {
  COMING
  NOT_COMING
  MAYBE
}

enum PaymentProvider {
  MANUAL_KASPI
  APIPAY
  CLOUDPAYMENTS
  FREEDOM_PAY
  HALYK_EPAY
  WOOPPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum PromoType {
  PERCENT
  FIXED
}

// Lifecycle of a single promo-code usage attempt, tracked per Payment (see
// PromoCodeUsage). RESERVED is created atomically alongside the Payment at
// checkout (this is what makes the global usage limit concurrency-safe —
// see PromoCode.usedCount); CONFIRMED once that Payment reaches PAID;
// RELEASED if the Payment is instead rejected/fails, so an abandoned
// attempt never permanently consumes a usage slot.
enum PromoUsageStatus {
  RESERVED
  CONFIRMED
  RELEASED
}

enum ReceiptSource {
  WEBSITE
  WHATSAPP
}

// Lifecycle of one uploaded receipt attempt (see PaymentReceipt). Separate
// from PaymentStatus on purpose — a receipt can fail/be rejected/be stuck
// in review while the underlying Payment simply stays PENDING throughout;
// Payment.status only ever changes when a receipt reaches AUTO_VERIFIED
// (via the shared successful-payment lifecycle) or an admin manually
// approves/rejects from the review queue.
enum ReceiptStatus {
  UPLOADED
  PROCESSING
  AUTO_VERIFIED
  REVIEW_REQUIRED
  REJECTED
  FAILED
}

// Fine-grained, machine-readable reason recorded alongside ReceiptStatus.
// ReceiptStatus answers "what state is this receipt in / does it need admin
// attention"; this answers "why" — VERIFIED is the only value that can ever
// lead to ReceiptStatus.AUTO_VERIFIED, everything else routes to
// REVIEW_REQUIRED (see src/lib/receipts/verify.ts — there is deliberately
// no automatic REJECTED outcome; only an admin can reject).
enum ReceiptVerificationResult {
  VERIFIED
  AMOUNT_MISMATCH
  PAYMENT_METHOD_MISMATCH
  IIN_MISMATCH
  RECEIPT_TOO_OLD
  DUPLICATE_RECEIPT
  EXTRACTION_FAILED
  INVALID_RECEIPT
  NOT_CONFIGURED
  MANUAL_REVIEW_REQUIRED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  phone        String?
  passwordHash String?
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invites         Invite[]
  payments        Payment[]
  auditLogs       AuditLog[]
  aiConversations AiConversation[]
  paymentReceipts PaymentReceipt[]

  @@index([email])
}

model Invite {
  id          String       @id @default(uuid())
  slug        String       @unique
  title       String
  description String?
  status      InviteStatus @default(DRAFT)
  data        Json         @default("{}")
  expiresAt   DateTime?
  publishedAt DateTime?
  viewCount   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Set when this invite originated from an anonymous pre-account draft
  // (see /api/invites/claim). Unique so claiming the same draft twice
  // (double-submit, redirect retries) idempotently returns the same invite
  // instead of creating a duplicate.
  sourceDraftToken String? @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  guests          Guest[]
  payments        Payment[]
  media           Media[]
  aiConversations AiConversation[]

  @@index([userId])
  @@index([slug])
  @@index([status])
}

model Guest {
  id          String      @id @default(uuid())
  name        String
  phone       String?
  email       String?
  status      GuestStatus @default(MAYBE)
  peopleCount Int         @default(1)
  note        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  inviteId String
  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@index([inviteId])
  @@index([status])
}

model Payment {
  id            String          @id @default(uuid())
  // `amount` remains the authoritative amount actually charged/payable
  // (= finalAmount) — every existing read site keeps working unchanged.
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("KZT")
  provider      PaymentProvider
  status        PaymentStatus   @default(PENDING)
  externalId    String?
  rawPayload    Json?
  screenshotUrl String?
  notes         String?
  approvedAt    DateTime?
  approvedBy    String?
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Immutable pricing snapshot, set once at creation and never touched
  // again — a later edit (or deletion) of the PromoCode row must never
  // change what a historical Payment says it charged. `originalAmount`/
  // `discountAmount` are null/0 for payments with no promo (and for rows
  // created before this migration). `promoCode` is the *text* of the code
  // at the time of use, independent of the FK, so it still displays
  // correctly even if the PromoCode row is later deleted.
  originalAmount Decimal?  @db.Decimal(10, 2)
  discountAmount Decimal   @default(0) @db.Decimal(10, 2)
  promoCode      String?
  promoCodeId    String?
  promoCodeRef   PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  inviteId String
  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Restrict)

  usage   PromoCodeUsage?
  receipts PaymentReceipt[]

  @@index([userId])
  @@index([inviteId])
  @@index([status])
  @@index([externalId])
  @@index([promoCodeId])
}

// One row per uploaded/submitted receipt attempt for a Payment. A Payment
// can have several (a blurry first attempt, a clearer retry) — this is
// deliberately NOT unique on paymentId. `receiptId` (the bank/Kaspi
// transaction id extracted from the receipt itself, NOT this row's own
// `id`) IS unique when present: Postgres unique constraints allow any
// number of NULLs, which is exactly the "unique when known, unenforced
// when the extractor couldn't read one" behavior required — see
// src/lib/receipts/verify.ts for how a NULL receiptId is handled instead
// (never silently treated as "safe").
//
// Payment.amount is the single authoritative expected amount (see the
// comment on that field) — verification always reads it fresh from the
// Payment row, never a value cached here or sent by the client.
model PaymentReceipt {
  id               String        @id @default(uuid())
  paymentId        String
  payment          Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  uploadedByUserId String
  uploadedBy       User          @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  source           ReceiptSource @default(WEBSITE)
  mediaKey         String
  // The PDF actually sent to the (PDF-only) extractor service — equals
  // `mediaKey` when the customer uploaded a PDF directly, or a converted
  // one-page wrapper around their JPG/PNG otherwise (see
  // src/lib/payment/receipt-extractor.ts). Kept separate from `mediaKey` so
  // the admin/customer preview always shows the original upload untouched.
  extractionMediaKey String?

  receiptId          String?   @unique
  extractedAmount    Decimal?  @db.Decimal(10, 2)
  extractedCurrency  String?
  // Legacy fields from a prior Anthropic-vision-based extractor — no longer
  // written by current code (the real extractor has no concept of
  // recipient/sender/confidence), kept so old rows remain viewable.
  extractedRecipient String?
  extractedSender    String?
  confidence         Float?
  extractedBank             String?
  extractedIin              String?
  extractedMethodOfPayment  String?
  // Raw, unparsed datetime string exactly as the extractor returned it —
  // kept alongside the parsed `extractedPaidAt` so a malformed/unparseable
  // date is still visible to an admin instead of silently disappearing.
  extractedDatetimeRaw     String?
  extractedPaidAt          DateTime?
  rawExtractionJson  Json?

  status             ReceiptStatus              @default(UPLOADED)
  verificationResult ReceiptVerificationResult?
  failureReason      String?
  checksJson         Json?

  createdAt  DateTime  @default(now())
  verifiedAt DateTime?

  @@index([paymentId])
  @@index([status])
}

// Admin-managed discount codes for the single existing invitation product
// (see src/lib/product.ts — there is only one priced product today, so
// this deliberately has no per-plan "scope" field; add one only if a
// second priced product is ever introduced). `usedCount` is the
// concurrency-safe counter — always mutated via a single guarded UPDATE
// (see src/lib/promo-codes.ts), never a read-then-write pair.
model PromoCode {
  id           String    @id @default(uuid())
  code         String    @unique
  type         PromoType
  value        Decimal   @db.Decimal(10, 2)
  minAmount    Decimal?  @db.Decimal(10, 2)
  maxDiscount  Decimal?  @db.Decimal(10, 2)
  usageLimit   Int?
  usagePerUser Int?
  usedCount    Int       @default(0)
  startsAt     DateTime?
  expiresAt    DateTime?
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  payments Payment[]
  usages   PromoCodeUsage[]

  @@index([enabled])
}

// One row per Payment that used a promo — tracks per-user usage counts and
// the reserve/confirm/release lifecycle described on PromoUsageStatus.
// Deliberately separate from Payment's own snapshot fields: this table is
// bookkeeping for *enforcement* (limits), Payment's own columns are the
// permanent financial *record*, and the two are allowed to diverge (e.g.
// this row can cascade away with the PromoCode; Payment's snapshot never
// does).
model PromoCodeUsage {
  id             String           @id @default(uuid())
  promoCodeId    String
  promoCode      PromoCode        @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId         String
  paymentId      String           @unique
  payment        Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  status         PromoUsageStatus @default(RESERVED)
  discountAmount Decimal          @db.Decimal(10, 2)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([promoCodeId, userId])
  @@index([promoCodeId, status])
}

model Media {
  id        String    @id @default(uuid())
  type      MediaType
  url       String
  key       String
  mimeType  String
  size      Int
  createdAt DateTime  @default(now())

  inviteId String
  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@index([inviteId])
}

// Admin-curated background-music catalog offered to customers in the
// constructor's "recommended songs" list. Deliberately its own model (not
// squeezed into the generic SiteSettings JSON blob): it needs multiple,
// orderable, individually-deletable rows — the same reason InviteTemplate
// below is its own model rather than a settings key. Every row must point
// at a real object the admin actually uploaded (see /admin/music) — never
// a title-only placeholder with no audio behind it.
model RecommendedTrack {
  id        String   @id @default(uuid())
  title     String
  artist    String?
  key       String   @unique
  mimeType  String
  size      Int
  duration  Int?
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, sortOrder])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
}

model SiteSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @default(now()) @updatedAt

  @@index([key])
}

// Keep for backward compat
model ProductSettings {
  id               String   @id @default(uuid())
  productKey       String   @unique
  price            Int
  currency         String   @default("KZT")
  activeDays       Int
  kaspiPaymentLink String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productKey])
}

model AiConversation {
  id        String      @id @default(uuid())
  inviteId  String
  invite    Invite      @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([inviteId, userId])
  @@index([userId])
  @@index([inviteId])
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String         @db.Text
  type           String?
  inputTokens    Int            @default(0)
  outputTokens   Int            @default(0)
  createdAt      DateTime       @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model InviteTemplate {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  nameKk        String?
  nameRu        String?
  category      String
  language      String   @default("both")
  style         String   @default("elegant")
  description   String?
  descriptionRu String?
  previewImage  String?
  demoImage     String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  isPremium     Boolean  @default(false)
  bg            String   @default("#FAF8F3")
  gradient      String   @default("from-stone-50 to-amber-50")
  accent        String   @default("#C4963E")
  textDark      String   @default("#1C1917")
  textMuted     String   @default("#78716C")
  dark          Boolean  @default(false)
  emoji         String   @default("✨")
  demoName1     String   @default("Атыңыз")
  demoName2     String?
  tags          String[] @default([])
  tagsKk        String[] @default([])
  tagsRu        String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@index([category])
}
