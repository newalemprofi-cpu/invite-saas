{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "outDir": "dist-worker",
    "rootDir": "src",
    "noEmit": false,
    "declaration": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/worker.ts",
    "src/lib/queue/connection.ts",
    "src/lib/queue/queues.ts",
    "src/lib/queue/jobs.ts",
    "src/lib/redis.ts",
    "src/lib/storage.ts"
  ]
}
